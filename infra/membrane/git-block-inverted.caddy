# ═══════════════════════════════════════════════════════════════════
# git.primals.eco — INVERTED MEMBRANE (Zero-Trust Default-Deny)
# ═══════════════════════════════════════════════════════════════════
#
# The cell membrane is default-deny. Trust is earned, not assumed.
#
# Order of precedence (Caddy evaluates top-to-bottom, first match wins):
#   1. Webhooks (unconditional passthrough)
#   2. Git protocol (authenticated by Forgejo — requires credentials)
#   3. Inner membrane (WireGuard — network-level trust)
#   4. Authenticated humans (valid session cookie)
#   5. Login/auth pages (must remain accessible)
#   6. Fleet immune system (P0-P5 per-IP directives)
#   7. Bot detection (heuristic fingerprinting)
#   7.25. JS challenge (blocks zero-JS fleets — sets cookie via JS)
#   7.5. Honeytokens (credential bait for scanner probe paths)
#   8. Storefront (existence-only: landing, explore, org/repo names, READMEs)
#   9. DEFAULT: Everything else → scatter (outer membrane)
#
# The full inversion: the default is scatter, not Forgejo.
# The public sees existence only — names, READMEs, org structure.
# All content access (source, commits, API, diffs, issues, wiki)
# requires authentication, WireGuard, or explicit agent grant.
# sporeGate stays on the inside via wg0. Access granted explicitly.

git.primals.eco {
	import security_headers
	import lysogeny
	import csp_proxy
	import access_log

	# ═══ LAYER 1: UNCONDITIONAL PASSTHROUGH ═══

	handle /webhook {
		reverse_proxy unix//run/membrane/webhook.sock
	}

	# ═══ LAYER 2: GIT PROTOCOL (Forgejo authenticates) ═══

	@git_protocol {
		path_regexp git_smart .*/(info/refs|git-upload-pack|git-receive-pack|HEAD|objects/.*)$
		header User-Agent *git/*
	}
	handle @git_protocol {
		reverse_proxy localhost:3000
	}

	# ═══ LAYER 3: INNER MEMBRANE (WireGuard — full trust) ═══

	@inner_membrane {
		remote_ip 10.13.37.0/24
	}
	handle @inner_membrane {
		reverse_proxy localhost:3000
	}

	# ═══ LAYER 4: AUTHENTICATED HUMANS (session cookie) ═══

	@authenticated_human {
		header Cookie *i_like_gitea*
	}
	handle @authenticated_human {
		reverse_proxy localhost:3000
	}

	# ═══ LAYER 5: AUTH PAGES (must remain accessible to log in) ═══

	@auth_pages {
		path /user/login
		path /user/login/*
		path /user/sign_up
		path /user/forgot_password
		path /user/oauth2/*
	}
	handle @auth_pages {
		reverse_proxy localhost:3000
	}

	# ═══ LAYER 6: FLEET IMMUNE SYSTEM (per-IP posture directives) ═══
	# Written dynamically by skunky-ingest CaddyBridge.
	# Most aggressive postures first (Disperse > Vanish > Scatter > etc.)

	# ~~FLEET_PRESSURE_START~~
	# ~~FLEET_PRESSURE_END~~

	# ═══ LAYER 7: BOT DETECTION (heuristic fingerprinting) ═══

	@meta_stealth {
		not header Accept-Language *
		header Accept-Encoding "gzip, deflate, zstd"
	}
	@malformed_lang {
		header Accept-Language "*q=0.9;q=0.9*"
	}
	@known_bots {
		header_regexp User-Agent "(?i)(bot|crawl|spider|facebookexternalhit|meta-externalagent|google|bing|yandex|semrush|ahref|mj12|bytespider|petalbot|gptbot|chatgpt|claude|amazonbot|applebot|dataprovider|DotBot|BLEXBot|SeznamBot|Sogou|Baidu|CCBot|DataForSeoBot|Qwant|ia_archiver|archive\.org_bot|Slurp|curl|wget|python|go-http|java|HeadlessChrome|Lighthouse|okhttp|scrapy|httpclient|libwww|lwp-|httpx|mechanize|aiohttp|requests|node-fetch|axios)"
	}
	@empty_ua {
		not header User-Agent *
	}
	@no_encoding {
		not header Accept-Encoding *
		not header User-Agent *git/*
	}
	@stale_chrome {
		header_regexp User-Agent "Chrome/(7[0-9]|8[0-9]|9[0-9]|1[0-4][0-9])\."
		not header Accept-Language *
	}

	handle @meta_stealth {
		header X-Membrane-Route "external"
		respond "This forge serves humans only. Automated access: https://github.com/ecoPrimals" 403
	}
	handle @malformed_lang {
		header X-Membrane-Route "external"
		respond "This forge serves humans only. Automated access: https://github.com/ecoPrimals" 403
	}
	handle @known_bots {
		header X-Membrane-Route "external"
		respond "This forge serves humans only. Automated access: https://github.com/ecoPrimals" 403
	}
	handle @empty_ua {
		header X-Membrane-Route "external"
		respond "This forge serves humans only. Automated access: https://github.com/ecoPrimals" 403
	}
	handle @no_encoding {
		header X-Membrane-Route "external"
		respond "This forge serves humans only. Automated access: https://github.com/ecoPrimals" 403
	}
	handle @stale_chrome {
		abort
	}

	# ═══ LAYER 7.25: JS CHALLENGE — static-asset-zero fleet defense ═══
	# The residential proxy fleet loads zero CSS, JS, or images in 10,000+
	# requests. Real browsers always execute JavaScript. This layer serves
	# a tiny JS challenge that sets a cookie. The fleet (which never runs
	# JS) gets stuck. Real browsers pass through transparently on first visit.
	#
	# With the existence-only lockdown, this applies to non-storefront paths
	# that would otherwise hit scatter. Authenticated humans bypass via
	# Layer 4 (gitea cookie). This catches fleet probing the storefront
	# paths too — they get the challenge before seeing even the README.

	@needs_js_challenge {
		not header Cookie *i_like_gitea*
		not header Cookie *_membrane_verified=1*
		not remote_ip 10.13.37.0/24
		not path /
		not path /explore
		not path /explore/*
		not path /user/login
		not path /user/login/*
		not path /user/sign_up
		not path /user/forgot_password
		not path /user/oauth2/*
		not path /webhook
		not path /assets/*
		not path /avatars/*
		not path /favicon.svg
		not path /robots.txt
		not path /sitemap.xml
		not path /.env
		not path /.env.*
		not path /wp-config.php*
		not path /.git/config
		not path /.aws/credentials
		not header User-Agent *git/*
	}
	handle @needs_js_challenge {
		header X-Membrane-Route "js-challenge"
		header Content-Type "text/html; charset=utf-8"
		respond `<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Verifying browser...</title>
<style>body{background:#1a1a2e;color:#94a3b8;font-family:system-ui;display:flex;justify-content:center;align-items:center;height:100vh;margin:0}
.v{text-align:center}.s{width:24px;height:24px;border:3px solid #475569;border-top-color:#60a5fa;border-radius:50%;animation:r .8s linear infinite;margin:0 auto 16px}
@keyframes r{to{transform:rotate(360deg)}}</style></head>
<body><div class="v"><div class="s"></div><p>Verifying browser&hellip;</p></div>
<script>document.cookie="_membrane_verified=1;path=/;max-age=86400;SameSite=Lax";location.reload();</script>
</body></html>` 200
	}

	# ═══ LAYER 7.5: HONEYTOKENS — complement system (credential bait) ═══
	# Serve fake-but-plausible credentials for common scanner probe paths.
	# When scanners harvest and USE these elsewhere, the destination system's
	# own security catches them (AWS GuardDuty, GitHub token scanning, etc.).
	# Deterministic per seed — same path always returns the same fake creds.

	@honeytoken_probe {
		path /.env
		path /.env.local
		path /.env.production
		path /.env.backup
		path /wp-config.php
		path /wp-config.php.bak
		path /.git/config
		path /config/database.yml
		path /config/database.yaml
		path /api/v1/keys
		path /debug/vars
		path /server-info
		path /.aws/credentials
		path /config.json
		path /config.yaml
	}
	handle @honeytoken_probe {
		reverse_proxy localhost:9753
	}

	# ═══ LAYER 8: STOREFRONT (existence-only — names + READMEs) ═══
	#
	# The public sees existence proof: what repos exist, org structure,
	# README content on repo landing pages. Nothing extractable.
	# This is the shop window — you can see what's inside but the
	# door is locked unless you have a key.

	# Static assets needed to render storefront pages
	@static_assets {
		path /assets/*
		path /avatars/*
		path /favicon.svg
		path /robots.txt
		path /sitemap.xml
	}
	handle @static_assets {
		reverse_proxy localhost:3000
	}

	# Storefront: landing page, explore, org pages, repo root (README)
	# These are the ONLY real Forgejo pages visible without auth.
	@storefront_landing {
		path /
		path /explore
		path /explore/repos
		path /explore/users
		path /explore/organizations
	}
	handle @storefront_landing {
		reverse_proxy localhost:3000
	}

	# Org and repo landing pages — shallow path only (/{owner} or /{owner}/{repo})
	# Deeper paths (/{owner}/{repo}/anything) fall through to scatter
	@storefront_shallow {
		path_regexp shallow_page ^/[a-zA-Z0-9_.-]+/?$
	}
	handle @storefront_shallow {
		reverse_proxy localhost:3000
	}

	# Repo root page — README visible, nothing deeper
	@storefront_repo_root {
		path_regexp repo_root ^/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/?$
	}
	handle @storefront_repo_root {
		reverse_proxy localhost:3000
	}

	# ═══ LAYER 8.5: API BLOCK — no unauthenticated API access ═══
	@api_block {
		path /api/*
	}
	handle @api_block {
		header X-Membrane-Route "api-blocked"
		respond `{"error":"Authentication required. This forge serves humans only.","docs":"https://github.com/ecoPrimals"}` 403
	}

	# ═══ LAYER 9: DEFAULT — SCATTER (outer membrane) ═══
	#
	# Everything not matched above goes to the scatter server.
	# Source trees, commits, diffs, issues, wiki, raw files, branches,
	# pulls, actions, tags, releases, settings, admin — all scatter.
	# The ion channel is now fully selective: only the storefront passes.
	handle {
		reverse_proxy localhost:9753
	}

	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}
