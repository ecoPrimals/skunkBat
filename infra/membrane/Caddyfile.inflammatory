# ═══════════════════════════════════════════════════════════════════
# INFLAMMATORY RESPONSE — Membrane lockdown when immune system fails
# ═══════════════════════════════════════════════════════════════════
#
# This Caddyfile is activated by the inflammatory watchdog when
# skunky-ingest stops heartbeating (crash, OOM, log rotation loss).
#
# Defense philosophy: the cell membrane is default-deny.
# When the immune system fails, the membrane tightens — it does NOT open.
#
# What stays open:
#   - Static sites (detroit, sporePrint, gorilla) — public evidence
#   - Git protocol (clone/push) — authenticated by Forgejo
#   - Authenticated web UI — humans with session cookies
#
# What closes:
#   - ALL unauthenticated deep content (src/, commit/, blame/, etc.)
#   - ALL bot/fleet access to git forge content
#
# No fleet IP lists needed. No scatter server dependency.
# Pure Caddy config — the membrane alone holds.

{
	email ops@primals.eco
	storage file_system /caddy
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}

(csp_static) {
	header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; manifest-src 'self'"
}

(csp_proxy) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss:; frame-ancestors 'none'"
}

(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}

(lysogeny) {
	header {
		X-License "AGPL-3.0-or-later; ORC; CC-BY-SA-4.0"
		X-License-URL "https://sporeprint.primals.eco/methodology/scyborg-licensing/"
		X-License-Full "https://sporeprint.primals.eco/LICENSE.txt"
		X-Source-Code "https://git.primals.eco/ecoPrimals"
		X-Lysogeny "active"
		X-Membrane-State "inflammatory"
		Link "<https://www.gnu.org/licenses/agpl-3.0.html>; rel=\"license\"; title=\"AGPL-3.0-or-later\", <https://azoralaw.com/orclicense/>; rel=\"license\"; title=\"ORC\", <https://creativecommons.org/licenses/by-sa/4.0/>; rel=\"license\"; title=\"CC-BY-SA-4.0\""
	}
}

# === ROOT DOMAIN ===
primals.eco {
	import security_headers
	import lysogeny
	import access_log

	handle /enroll* {
		reverse_proxy 127.0.0.1:7780
	}
	handle {
		redir https://sporeprint.primals.eco{uri} permanent
	}
}

www.primals.eco {
	redir https://sporeprint.primals.eco{uri} permanent
}

# === sporePrint — static, serves normally ===
sporeprint.primals.eco {
	import security_headers
	import lysogeny
	import csp_static
	import access_log
	encode gzip

	root * /opt/ecoPrimals/sporePrint/public

	handle /lab/spores/* {
		try_files {path} {path}/index.html
		file_server
	}
	handle {
		try_files {path} {path}/index.html
		file_server
	}
}

# === detroit — static evidence site, serves normally ===
detroit.primals.eco {
	import security_headers
	import lysogeny
	import csp_static
	import access_log
	encode gzip

	root * /opt/ecoPrimals/detroit/site/public

	handle {
		try_files {path} {path}/index.html
		file_server
	}
}

# ═══════════════════════════════════════════════════════════════════
# GIT FORGE — INFLAMMATORY LOCKDOWN
# ═══════════════════════════════════════════════════════════════════
#
# The membrane tightens. Only three things pass:
#   1. Git protocol (clone/push) — Forgejo authenticates
#   2. WireGuard (inner membrane) — trusted by network layer
#   3. Authenticated humans — valid session cookie
#
# Everything else hits the inflammatory wall.

git.primals.eco {
	import security_headers
	import lysogeny
	import csp_proxy
	import access_log

	# 1. Git smart HTTP protocol — Forgejo authenticates these
	@git_protocol {
		path_regexp git_smart .*/(info/refs|git-upload-pack|git-receive-pack|HEAD|objects/.*)$
		header User-Agent *git/*
	}
	handle @git_protocol {
		reverse_proxy localhost:3000
	}

	# 2. WireGuard inner membrane — full trust
	@inner_membrane {
		remote_ip 10.13.37.0/24
	}
	handle @inner_membrane {
		reverse_proxy localhost:3000
	}

	# 3. Authenticated humans — valid Forgejo session
	@authenticated {
		header Cookie *i_like_gitea*
	}
	handle @authenticated {
		reverse_proxy localhost:3000
	}

	# 4. Login/auth pages — must remain accessible for humans to authenticate
	@auth_pages {
		path /user/login
		path /user/login/*
		path /user/sign_up
		path /user/forgot_password
		path /user/oauth2/*
		path /assets/*
		path /avatars/*
		path /favicon.svg
		path /
	}
	handle @auth_pages {
		reverse_proxy localhost:3000
	}

	# 5. INFLAMMATORY WALL — everything else blocked
	handle {
		header X-Membrane-State "inflammatory"
		header X-Membrane-Reason "immune-system-offline"
		respond 503 {
			body "Membrane integrity check in progress. Authenticated access and git protocol remain available. For automated access: https://github.com/ecoPrimals"
			close
		}
	}
}

# === Other sites — serve normally (static / low-risk) ===

footprint.primals.eco {
	import security_headers
	import lysogeny
	import access_log
	redir https://sporeprint.primals.eco{uri} permanent
}

webb.primals.eco {
	import security_headers
	import lysogeny
	import access_log
	redir https://sporeprint.primals.eco{uri} permanent
}

membrane.primals.eco {
	import security_headers
	import lysogeny
	import access_log
	respond "membrane: inflammatory" 200
}

lab.primals.eco {
	import security_headers
	import lysogeny
	import access_log
	redir https://sporeprint.primals.eco/lab{uri} permanent
}

live.primals.eco {
	import security_headers
	import lysogeny
	import access_log
	respond "inflammatory" 503
}

ca.primals.eco {
	import security_headers
	import access_log
	reverse_proxy 127.0.0.1:7780
}

depot.primals.eco {
	import security_headers
	import lysogeny
	import access_log
	# Depot locked during inflammatory response
	respond "Membrane integrity check in progress." 503
}

relay.primals.eco {
	import security_headers
	import access_log
	basic_auth {
		relay $2a$14$placeholder
	}
	respond "relay: inflammatory" 200
}

nestgate.io {
	import security_headers
	import lysogeny
	import access_log
	# nestgate locked during inflammatory response
	respond "Membrane integrity check in progress." 503
}

www.nestgate.io {
	redir https://nestgate.io{uri} permanent
}

gorilla.primals.eco, guerillagorilla.primals.eco {
	root * /opt/ecoPrimals/guerillaGorilla/site/public
	encode gzip
	import lysogeny
	import access_log

	handle {
		try_files {path} {path}/index.html
		file_server
	}
}
